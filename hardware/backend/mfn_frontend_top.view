# ============================================================
# MMMC View File — MobileFaceNet Frontend
# Single-corner: typical PVT (1.1V, 25°C)
# ============================================================

create_library_set \
    -name tt_libs \
    -timing { /vol/ece303/genus_tutorial/NangateOpenCellLibrary_typical.lib }

create_rc_corner \
    -name rc_typical \
    -T 25

create_delay_corner \
    -name dc_typical \
    -library_set tt_libs \
    -rc_corner rc_typical

create_constraint_mode \
    -name cm_func \
    -sdc_files { ../frontend/syn/constraints.sdc }

create_analysis_view \
    -name setup_view \
    -constraint_mode cm_func \
    -delay_corner dc_typical

create_analysis_view \
    -name hold_view \
    -constraint_mode cm_func \
    -delay_corner dc_typical

set_analysis_view \
    -setup { setup_view } \
    -hold  { hold_view }
