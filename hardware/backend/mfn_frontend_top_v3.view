# ============================================================
# MMMC View File v3 — MobileFaceNet Frontend (12×12 SA)
# Target: 200 MHz / 5.0 ns (note §35 Stage 3 max-push)
# Lib: NangateOpenCellLibrary + psum SRAM lib + act_buf SRAM lib.
# Note: mfn_weight_rom_v3 and ROM black boxes have no .lib;
#       Innovus will warn but proceed (0-cell modules in netlist).
# ============================================================

create_library_set \
    -name tt_libs \
    -timing { \
        /vol/ece303/genus_tutorial/NangateOpenCellLibrary_typical.lib \
        ../frontend/syn/lib/sram_psum_a_1rw1r0w_40_512_freepdk45.lib \
        ../frontend/syn/lib/sram_psum_b_1rw0r0w_40_512_freepdk45.lib \
        ../frontend/syn/lib/sram_act_buf_1rw0r0w_192_64_freepdk45.lib \
    }

create_rc_corner \
    -name rc_typical \
    -T 25

create_delay_corner \
    -name dc_typical \
    -library_set tt_libs \
    -rc_corner rc_typical

create_constraint_mode \
    -name cm_func \
    -sdc_files { ./constraints_v3.sdc }

create_analysis_view \
    -name setup_view \
    -constraint_mode cm_func \
    -delay_corner dc_typical

create_analysis_view \
    -name hold_view \
    -constraint_mode cm_func \
    -delay_corner dc_typical

set_analysis_view \
    -setup { setup_view } \
    -hold  { hold_view }
